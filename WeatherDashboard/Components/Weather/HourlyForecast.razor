@* HourlyForecast: 시간별 예보. 기준 시각 이후 8개 시점을 렌더링. *@
@using WeatherDashboard.Models

<section class="weather-card hourly-forecast" aria-label="시간별 예보">
    <h2 class="forecast-title">시간별 예보</h2>

    @{
        var items = GetVisibleItems();
    }

    @if (items.Count == 0)
    {
        <p class="placeholder-text">표시할 시간별 예보가 없습니다.</p>
    }
    else
    {
        <ul class="hourly-list" role="list">
            @foreach (var item in items)
            {
                <li class="hourly-item"
                    aria-label="@($"{item.Time:HH:mm} {item.Condition.Description}, 기온 {item.Temperature:0}도, 강수확률 {PopLabel(item.PrecipitationProbability)}")">
                    <span class="hourly-time tabular" aria-hidden="true">@item.Time.ToString("HH:mm")</span>
                    <span class="hourly-emoji" aria-hidden="true">@item.Condition.Emoji</span>
                    <span class="hourly-temp tabular" aria-hidden="true">@item.Temperature.ToString("0")℃</span>
                    <span class="hourly-pop tabular" aria-hidden="true">💧 @PopLabel(item.PrecipitationProbability)</span>
                </li>
            }
        </ul>
    }
</section>

@code {
    /// <summary>시간별 예보 항목(#1의 모델). 기준 시각 이후 8개 시점을 표시한다.</summary>
    [Parameter]
    public IReadOnlyList<HourlyForecastItem>? Items { get; set; }

    /// <summary>
    /// "현재" 판단 기준 시각. 데이터와 동일한 시간대(예보 위치의 로컬 시각)를 전달해야 한다.
    /// 미지정 시 서버 로컬 시각(<see cref="DateTime.Now"/>)으로 대체한다.
    /// </summary>
    [Parameter]
    public DateTime? ReferenceTime { get; set; }

    /// <summary>표시 시점 개수.</summary>
    private const int VisibleCount = 8;

    /// <summary>기준 시각 이후의 항목을 날짜순으로 최대 8개 선택한다. 없으면 빈 목록.</summary>
    private IReadOnlyList<HourlyForecastItem> GetVisibleItems()
    {
        if (Items is null || Items.Count == 0)
        {
            return Array.Empty<HourlyForecastItem>();
        }

        var reference = ReferenceTime ?? DateTime.Now;

        return Items
            .Where(i => i.Time >= reference)
            .OrderBy(i => i.Time)
            .Take(VisibleCount)
            .ToList();
    }

    /// <summary>강수확률을 표시용 문자열로 변환. null 이면 정보 없음("—").</summary>
    private static string PopLabel(int? probability) =>
        probability is int p ? $"{p}%" : "—";
}
