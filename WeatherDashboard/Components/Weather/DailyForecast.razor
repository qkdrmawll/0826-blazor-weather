@* DailyForecast: 일별 예보. 5일치를 렌더링. *@
@using System.Globalization
@using WeatherDashboard.Models

<section class="weather-card daily-forecast" aria-label="일별 예보">
    <h2 class="forecast-title">일별 예보</h2>

    @{
        var items = GetVisibleItems();
    }

    @if (items.Count == 0)
    {
        <p class="placeholder-text">표시할 일별 예보가 없습니다.</p>
    }
    else
    {
        <ul class="daily-list" role="list">
            @foreach (var item in items)
            {
                <li class="daily-item"
                    aria-label="@($"{GetWeekday(item.Date)}요일 {item.Condition.Description}, 최고 {item.TemperatureMax:0}도, 최저 {item.TemperatureMin:0}도, 강수확률 {PopLabel(item.PrecipitationProbabilityMax)}")">
                    <span class="daily-day" aria-hidden="true">@GetWeekday(item.Date)</span>
                    <span class="daily-condition" aria-hidden="true">
                        <span class="daily-emoji">@item.Condition.Emoji</span>
                        <span class="daily-desc">@item.Condition.Description</span>
                    </span>
                    <span class="daily-pop tabular" aria-hidden="true">💧 @PopLabel(item.PrecipitationProbabilityMax)</span>
                    <span class="daily-temp" aria-hidden="true">
                        <span class="daily-temp-max tabular"><span class="temp-cue">최고</span> @item.TemperatureMax.ToString("0")°</span>
                        <span class="daily-temp-min tabular"><span class="temp-cue">최저</span> @item.TemperatureMin.ToString("0")°</span>
                    </span>
                </li>
            }
        </ul>
    }
</section>

@code {
    /// <summary>일별 예보 항목(#1의 모델). 최대 5일치를 표시한다.</summary>
    [Parameter]
    public IReadOnlyList<DailyForecastItem>? Items { get; set; }

    /// <summary>표시 일수.</summary>
    private const int VisibleCount = 5;

    /// <summary>날짜순으로 최대 5일치를 선택한다. 데이터가 없으면 빈 목록.</summary>
    private IReadOnlyList<DailyForecastItem> GetVisibleItems()
    {
        if (Items is null || Items.Count == 0)
        {
            return Array.Empty<DailyForecastItem>();
        }

        return Items.OrderBy(i => i.Date).Take(VisibleCount).ToList();
    }

    /// <summary>한글 요일(예: "월").</summary>
    private static string GetWeekday(DateOnly date) =>
        date.ToDateTime(TimeOnly.MinValue)
            .ToString("ddd", CultureInfo.GetCultureInfo("ko-KR"));

    /// <summary>강수확률을 표시용 문자열로 변환. null 이면 정보 없음("—").</summary>
    private static string PopLabel(int? probability) =>
        probability is int p ? $"{p}%" : "—";
}
