@page "/"
@rendermode InteractiveServer
@using WeatherDashboard.Models
@using WeatherDashboard.Services
@using WeatherDashboard.Components.Weather
@inject IWeatherService WeatherService

<PageTitle>날씨 대시보드</PageTitle>

<div class="weather-dashboard">
    <header class="dashboard-header">
        <h1>🌤️ 날씨 대시보드</h1>
        <p class="subtitle">도시명을 입력하면 현재 날씨와 예보를 보여줍니다. (데이터: Open-Meteo)</p>
    </header>

    <section class="search-area">
        <EditForm Model="this" OnValidSubmit="SearchAsync">
            <div class="search-bar">
                <InputText @bind-Value="_city" class="search-input" placeholder="예: 서울, Tokyo, London" />
                <button type="submit" class="search-button" disabled="@_isLoading">검색</button>
            </div>
        </EditForm>
    </section>

    <section class="status-area">
        @if (_isLoading)
        {
            <p class="status status-loading">불러오는 중…</p>
        }
        else if (_error is not null)
        {
            <p class="status status-error">@_error</p>
        }
    </section>

    <section class="results-area">
        <CurrentWeatherCard Weather="_weather" />
        <HourlyForecast Items="_weather?.Hourly" ReferenceTime="_weather?.Current.Time" />
        <DailyForecast Items="_weather?.Daily" />
    </section>
</div>

@code {
    private string _city = string.Empty;
    private bool _isLoading;
    private string? _error;
    private WeatherResult? _weather;

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_city))
        {
            _error = "도시명을 입력해 주세요.";
            return;
        }

        _isLoading = true;
        _error = null;

        try
        {
            var result = await WeatherService.GetWeatherByCityAsync(_city);
            if (result is null)
            {
                _error = $"'{_city}' 도시를 찾을 수 없습니다.";
                _weather = null;
            }
            else
            {
                _weather = result;
            }
        }
        catch (Exception ex)
        {
            _error = $"날씨 정보를 불러오지 못했습니다: {ex.Message}";
            _weather = null;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
